# Database Configuration
# Update these values based on your SQL Server setup

# ODBC Driver name (usually "ODBC Driver 17 for SQL Server" on Windows)
DB_DRIVER={ODBC Driver 17 for SQL Server}

# SQL Server instance name
# Example: DESKTOP-XXXX\SQLEXPRESS or localhost\SQLINSTANCE
DB_SERVER=DESKTOP-62TRPPU\SQLEXPRESS

# Database name
DB_NAME=SmartCityDB

# Trusted connection (yes/no)
# Set to "yes" for Windows authentication, "no" to use username/password
DB_TRUSTED=yes

# Optional: Username for SQL authentication (if DB_TRUSTED=no)
# DB_USER=sa

# Optional: Password for SQL authentication (if DB_TRUSTED=no)
# DB_PASSWORD=your_password_here
